# AuraFit Environment Configuration Template

# REQUIRED: Google Gemma API Key
# Get your API key from: https://ai.google.dev
GOOGLE_API_KEY=YOUR_API_KEY_HERE

# Gemma Model Selection
# Options: gemma-4-26b-a4b-it (recommended), gemma-3-27b-it, gemma-2-27b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Database Configuration
DATABASE_PATH=data/aurafit.db

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Future: Offline Configuration (when using local Ollama)
# OLLAMA_ENDPOINT=http://localhost:11434
# AURAFIT_MODE=LOCAL_OFFLINE
